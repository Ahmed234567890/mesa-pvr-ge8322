+/*
+ * EGL_EXT_device_query entry points.
+ *
+ * libhybris has no EGLDeviceEXT objects: the vendor stack is bound to the
+ * Android display and this device exposes no DRM device at all. Applications
+ * still resolve these two symbols unconditionally before they try EGL (Firefox
+ * glxtest does, and calls eglQueryDisplayAttribEXT() without a NULL check), so
+ * provide the entry points and fail cleanly instead of leaving them unresolved.
+ *
+ * Neither function is advertised in the extension strings; a caller that gets
+ * EGL_FALSE here is expected to fall back to its non-EGLDeviceEXT path.
+ */
+EGLBoolean eglQueryDisplayAttribEXT(EGLDisplay dpy, EGLint name, EGLAttrib *value)
+{
+	(void) dpy;
+	(void) name;
+	(void) value;
+
+	__eglHybrisSetError(EGL_BAD_PARAMETER);
+	return EGL_FALSE;
+}
+
+const char * eglQueryDeviceStringEXT(EGLDeviceEXT device, EGLint name)
+{
+	(void) device;
+	(void) name;
+
+	__eglHybrisSetError(EGL_BAD_PARAMETER);
+	return NULL;
+}
