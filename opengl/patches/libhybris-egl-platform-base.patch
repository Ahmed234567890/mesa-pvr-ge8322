+/*
+ * EGL_EXT_platform_base is implemented in egl.c (eglGetPlatformDisplay,
+ * eglCreatePlatformWindowSurface, ...), but the vendor client extension
+ * string is passed through verbatim, so applications that check
+ * eglQueryString(EGL_NO_DISPLAY, EGL_EXTENSIONS) before touching a display
+ * never see it and fall back to eglGetDisplay(). Merge the extensions we
+ * actually implement into that string.
+ *
+ * EGL_EXT_platform_x11 is only advertised when the X11 platform module is
+ * installed, because eglGetPlatformDisplay(EGL_PLATFORM_X11_KHR, ...) would
+ * abort in ws_init() otherwise.
+ */
+static const char *ws_platform_dir(void)
+{
+	const char *user_eglplatform_dir = getauxval(AT_SECURE)
+					   ? NULL
+					   : getenv("HYBRIS_EGLPLATFORM_DIR");
+
+	return user_eglplatform_dir ? user_eglplatform_dir : PKGLIBDIR;
+}
+
+static int ws_platform_available(const char *platform)
+{
+	char ws_lib_path[2048];
+	const char *eglplatform_dir = ws_platform_dir();
+
+	snprintf(ws_lib_path, sizeof(ws_lib_path), "%s/eglplatform_%s.so",
+		 eglplatform_dir, platform);
+
+	return access(ws_lib_path, R_OK) == 0;
+}
+
+/* Match a whole extension name, not a substring of a longer one. */
+static int ws_has_extension(const char *extensions, const char *extension)
+{
+	size_t len = strlen(extension);
+	const char *p = extensions;
+
+	while (p != NULL && (p = strstr(p, extension)) != NULL) {
+		int starts_token = (p == extensions) || (p[-1] == ' ');
+		int ends_token = (p[len] == '\0') || (p[len] == ' ');
+
+		if (starts_token && ends_token)
+			return 1;
+		p += len;
+	}
+	return 0;
+}
+
+/*
+ * Returns the extensions this wrapper adds on top of the vendor client
+ * extensions, including the leading space needed to append them. The result
+ * only depends on the installed platform modules, so it is built once.
+ */
+static const char *ws_platform_client_extensions(void)
+{
+	static char additions[128];
+	static int built = 0;
+	static pthread_mutex_t additions_mutex = PTHREAD_MUTEX_INITIALIZER;
+
+	pthread_mutex_lock(&additions_mutex);
+	if (!built) {
+		size_t used = 0;
+
+		additions[0] = '\0';
+
+		snprintf(additions + used, sizeof(additions) - used,
+			 " EGL_EXT_platform_base");
+		used = strlen(additions);
+
+		if (ws_platform_available("x11")) {
+			snprintf(additions + used, sizeof(additions) - used,
+				 " EGL_EXT_platform_x11 EGL_KHR_platform_x11");
+		}
+
+		built = 1;
+	}
+	pthread_mutex_unlock(&additions_mutex);
+
+	return additions;
+}
+
+static const char *ws_client_extensions(const char *vendor_extensions)
+{
+	static char merged[2048];
+	static int built = 0;
+	static pthread_mutex_t merged_mutex = PTHREAD_MUTEX_INITIALIZER;
+	const char *additions;
+	const char *token;
+
+	if (vendor_extensions == NULL)
+		return ws_platform_client_extensions();
+
+	additions = ws_platform_client_extensions();
+
+	pthread_mutex_lock(&merged_mutex);
+	if (!built) {
+		snprintf(merged, sizeof(merged), "%s", vendor_extensions);
+
+		/* additions is " EGL_A EGL_B ..."; append what is missing. */
+		token = additions;
+		while (*token != '\0') {
+			char name[64];
+			const char *end;
+			size_t len;
+
+			while (*token == ' ')
+				token++;
+			if (*token == '\0')
+				break;
+
+			end = strchr(token, ' ');
+			len = end ? (size_t)(end - token) : strlen(token);
+			if (len >= sizeof(name))
+				len = sizeof(name) - 1;
+			memcpy(name, token, len);
+			name[len] = '\0';
+
+			if (!ws_has_extension(vendor_extensions, name)) {
+				size_t used = strlen(merged);
+
+				if (used + len + 2 < sizeof(merged))
+					snprintf(merged + used, sizeof(merged) - used,
+						 " %s", name);
+			}
+
+			token += len;
+		}
+
+		built = 1;
+	}
+	pthread_mutex_unlock(&merged_mutex);
+
+	return merged;
+}
